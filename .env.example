# Servora Provider — environment configuration
# Copy to .env for local development. Never commit a real .env file.

# --- Runtime ---
NODE_ENV=development
# Matches PROVIDER_SERVICE_URL=http://localhost:4010 reserved for this
# service in servora-api-gateway/.env.example.
PORT=4010
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL is authoritative) ---
# This service owns its own database (servora_provider, inside the shared
# Neon `servora` project) and never reads or writes the auth/services/
# booking/payment databases.
DATABASE_URL=postgresql://provider:provider@localhost:5434/servora_provider

# --- Cache (optional; see README "Caching strategy") ---
# When unset, an in-process no-op-on-restart cache is used instead — fine
# for a single instance / local dev. Set this to enable a shared Redis
# cache across instances in production. Redis is never authoritative.
REDIS_URL=
CACHE_TTL_SECONDS=60

# --- Trusted identity headers ---
# The API Gateway verifies the caller's session itself and forwards the
# resolved identity as these headers (see
# servora-api-gateway/src/routes/v1/proxy.ts buildForwardHeaders). This
# service never verifies a session token or decodes a JWT — it only trusts
# these headers, the same as every other downstream service behind the
# gateway. Only change these if the gateway's own header names change.
USER_ID_HEADER=x-user-id
USER_ROLE_HEADER=x-user-role

# --- servora-services integration ---
# Base URL of the service-catalog service. Used to validate a service_id
# (existence + ACTIVE status) when a provider adds/updates an offering.
SERVICES_API_BASE_URL=http://localhost:4004
SERVICES_API_TIMEOUT_MS=5000

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Request handling ---
REQUEST_ID_HEADER=x-request-id
BODY_LIMIT_BYTES=1048576
